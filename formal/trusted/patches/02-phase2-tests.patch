+                Err((
+                    "mismatch",
+                    "https://x.example".to_owned(),
+                    "https://auth.example.com/".to_owned()
+                ))
+            );
+            // The OpenID Connect path-appended form derives an expected issuer too.
+            assert_eq!(
+                check(&appended, None, Some("https://evil.example")),
+                Err((
+                    "mismatch",
+                    "https://auth.example.com/t1".to_owned(),
+                    "https://evil.example".to_owned()
+                ))
+            );
+            assert_eq!(
+                check(&appended, None, Some("https://auth.example.com/t1")),
+                Ok(())
