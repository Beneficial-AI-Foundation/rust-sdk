+    // A09 callee (H8): only a root URL may differ by one trailing slash.
+    #[test]
+    fn d5_a09_issuer_root_slash() {
+        let eq = AuthorizationManager::issuer_identifiers_match;
+        assert!(eq("https://auth.example.com", "https://auth.example.com/"));
+        assert!(eq(
+            "https://auth.example.com:8443/",
+            "https://auth.example.com:8443"
