+    // A09 (H6, H7): validate_authorization_metadata_issuer with and without
+    // allow_missing_issuer, an explicit or a derived expected issuer, and none at all.
+    #[tokio::test]
+    async fn d5_a09_metadata_issuer_paths() {
+        let mut manager = AuthorizationManager::new("https://mcp.example.com/")
+            .await
+            .unwrap();
+        let metadata = |issuer: Option<&str>| AuthorizationMetadata {
+            issuer: issuer.map(str::to_owned),
+            ..Default::default()
+        };
+        let derived =
+            Url::parse("https://auth.example.com/.well-known/oauth-authorization-server/t1?q=1#f")
+                .unwrap();
+        let root = Url::parse("https://auth.example.com/.well-known/openid-configuration").unwrap();
+        let other = Url::parse("https://auth.example.com/metadata").unwrap();
+        let appended =
+            Url::parse("https://auth.example.com/t1/.well-known/openid-configuration").unwrap();
+        for allow in [false, true] {
+            manager.set_allow_missing_issuer(allow);
+            let check = |url: &Url, expected: Option<&str>, issuer: Option<&str>| {
+                manager
+                    .validate_authorization_metadata_issuer(url, expected, &metadata(issuer))
+                    .map_err(d5_issuer_error)
+            };
+            let missing = |iss: &str| {
+                if allow {
+                    Ok(())
+                } else {
+                    Err(("missing", iss.to_owned(), String::new()))
+                }
+            };
+            assert_eq!(
+                check(&derived, None, None),
+                missing("https://auth.example.com/t1")
+            );
+            assert_eq!(
+                check(&root, None, None),
+                missing("https://auth.example.com/")
+            );
+            assert_eq!(
+                check(&other, Some("https://x.example"), None),
+                missing("https://x.example")
+            );
+            assert_eq!(check(&other, None, None), Ok(()));
+            assert_eq!(check(&other, None, Some("https://evil.example")), Ok(()));
+            assert_eq!(check(&root, None, Some("https://auth.example.com")), Ok(()));
+            assert_eq!(
+                check(&derived, None, Some("https://auth.example.com/t1")),
+                Ok(())
+            );
+            assert_eq!(
+                check(&derived, None, Some("https://auth.example.com/t1/")),
+                Err((
+                    "mismatch",
+                    "https://auth.example.com/t1".to_owned(),
+                    "https://auth.example.com/t1/".to_owned()
+                ))
+            );
+            assert_eq!(
+                check(
+                    &root,
+                    Some("https://x.example"),
+                    Some("https://auth.example.com/")
