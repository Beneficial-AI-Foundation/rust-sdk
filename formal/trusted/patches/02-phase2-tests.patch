+#[cfg(test)]
+mod phase2_boundary_tests {
+    // Patch 02 (plan step S34, human decision H3): plan Section 22 boundary cases of T07/T08.
+    // Expected values from the signed-off statements in
+    // `formal/proofs/Proofs/Internal/Transport/StreamableHttpServer/Tower.lean` and
+    // `Defs.Tower.defaultPort` (`formal/proofs/Proofs/Defs/Tower.lean`); not from running the
+    // code. Direct calls, so they need no `transport-streamable-http-client-reqwest` feature.
+
+    use super::*;
+
+    // plan §22 T07/T08 (`"http"`, `"https"`, `"HTTP"`, `"ftp"`); Theorems.tower.default_port:
+    // `Defs.Tower.defaultPort`, exact case-sensitive bytes: `some 80`, `some 443`, else `none`.
+    #[test]
+    fn s34_t07_default_port_schemes() {
+        assert_eq!(default_port("http"), Some(80));
+        assert_eq!(default_port("https"), Some(443));
+        assert_eq!(default_port("HTTP"), None);
+        assert_eq!(default_port("ftp"), None);
+        assert_eq!(default_port("HTTPS"), None);
+        assert_eq!(default_port(""), None);
+        assert_eq!(default_port("ws"), None);
+    }
+
+    // plan §22 T07/T08 (`Any`/`Unspecified`); Theorems.tower.AllowedPort.matches: `true` for
+    // every scheme and port.
+    #[test]
+    fn s34_t08_any_and_unspecified_match_everything() {
+        for allowed in [AllowedPort::Any, AllowedPort::Unspecified] {
+            for scheme in ["http", "https", "HTTP", "ftp", ""] {
+                for port in [
+                    None,
+                    Some(0),
+                    Some(80),
+                    Some(443),
+                    Some(8443),
+                    Some(u16::MAX),
+                ] {
+                    assert!(
+                        allowed.matches(scheme, port),
+                        "{allowed:?}.matches({scheme:?}, {port:?})"
+                    );
+                }
+            }
+        }
+    }
+
+    // plan §22 T07/T08 (`Exact 443` with `None` and `https`); Theorems.tower.AllowedPort.matches:
+    // `(none <|> defaultPort "https") = some 443`, so `true`; with another scheme the default
+    // is `none` or 80, so `false`.
+    #[test]
+    fn s34_t08_exact_443_none_https() {
+        assert!(AllowedPort::Exact(443).matches("https", None));
+        assert!(!AllowedPort::Exact(443).matches("http", None));
+        assert!(!AllowedPort::Exact(443).matches("HTTPS", None));
+        assert!(!AllowedPort::Exact(443).matches("ftp", None));
+    }
+
+    // plan §22 T07/T08 (`Exact 80` with `Some 8080`); Theorems.tower.AllowedPort.matches:
+    // `(some 8080 <|> _) = some 8080 ≠ some 80`, so `false` whatever the scheme; the explicit
+    // port wins over the default.
+    #[test]
+    fn s34_t08_exact_80_some_8080() {
+        for scheme in ["http", "https", "HTTP", "ftp"] {
+            assert!(
