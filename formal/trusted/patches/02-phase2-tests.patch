diff --git a/crates/rmcp/src/transport/common/client_side_sse.rs b/crates/rmcp/src/transport/common/client_side_sse.rs
index 26d2f77..b1e3c2b 100644
--- a/crates/rmcp/src/transport/common/client_side_sse.rs
+++ b/crates/rmcp/src/transport/common/client_side_sse.rs
@@ -877,4 +877,150 @@ mod tests {
         assert!(policy.retry(2).is_some());
         assert!(policy.retry(3).is_none());
     }
+
+    // ---- Patch 02 (plan step S34, human decision H3): plan Section 22 boundary cases. ----
+    // Expected values (verdict and state) from the signed-off statements in
+    // `formal/proofs/Proofs/Internal/Transport/Common/ClientSideSse.lean` and the model
+    // `Defs.Sse` (`formal/proofs/Proofs/Defs/Sse.lean`, with `cap = usize::MAX`), mostly its
+    // kernel-checked regression checks; not from running the code. These call the limiter
+    // directly, so the state after a call (not observable through `bounded_sse_stream`) is
+    // checked too. State tuple: (max_size, retained_size, line_size, line_is_comment,
+    // previous_was_cr), the fields of `Defs.Sse.State`. Start states are built explicitly with
+    // `s34_limiter` (`Defs.Sse.init n` = (n, 0, 0, false, false)), not with
+    // `SseEventSizeLimiter::new`, which no signed-off statement covers.
+
+    type S34State = (usize, usize, usize, bool, bool);
+
+    fn s34_limiter(st: S34State) -> SseEventSizeLimiter {
+        SseEventSizeLimiter {
+            max_size: st.0,
+            retained_size: st.1,
+            line_size: st.2,
+            line_is_comment: st.3,
+            previous_was_cr: st.4,
+        }
+    }
+
+    fn s34_state(l: &SseEventSizeLimiter) -> S34State {
+        (
+            l.max_size,
+            l.retained_size,
+            l.line_size,
+            l.line_is_comment,
+            l.previous_was_cr,
+        )
+    }
+
+    // plan §22 T01/T02 (saturating past `max`); Theorems.client_side_sse.SseEventSizeLimiter.
+    // check_limit (`Err` iff `satAdd(retained, line) > max`) and finish_line (`Defs.Sse.
+    // finishLine`: `retained := satAdd(satAdd(retained, line), 1)`, then T01). `Sse`:
+    // `satAdd usizeMax64 usizeMax64 1 = usizeMax64`, `withinLimit` at the cap.
+    #[test]
+    fn s34_t01_t02_saturating_past_max() {
+        let m = usize::MAX;
+        // T01: the sum saturates at usize::MAX, which is within a bound of usize::MAX ...
+        assert_eq!(s34_limiter((m, m, m, false, false)).check_limit(), Ok(()));
+        assert_eq!(
+            s34_limiter((m, m - 1, 2, false, false)).check_limit(),
+            Ok(())
+        );
+        // ... and past a bound of usize::MAX - 1.
+        assert_eq!(
+            s34_limiter((m - 1, m - 1, 2, false, false)).check_limit(),
+            Err(())
+        );
+        assert_eq!(
+            s34_limiter((m - 1, m, m, false, false)).check_limit(),
+            Err(())
+        );
+        // T01 at and one above the bound, for reference.
+        assert_eq!(s34_limiter((9, 4, 5, false, false)).check_limit(), Ok(()));
+        assert_eq!(s34_limiter((9, 5, 5, false, false)).check_limit(), Err(()));
+
+        // T02 on a non-comment line: retained saturates at usize::MAX.
+        let mut l = s34_limiter((m, 1, m, false, false));
+        assert_eq!(l.finish_line(), Ok(()));
+        assert_eq!(s34_state(&l), (m, m, 0, false, false));
+        let mut l = s34_limiter((m - 1, 1, m, false, false));
+        assert_eq!(l.finish_line(), Err(()));
+        assert_eq!(s34_state(&l), (m - 1, m, 0, false, false));
+        // T02 on a comment line: retained unchanged; on an empty line: reset to 0.
+        let mut l = s34_limiter((m - 1, m, m, true, false));
+        assert_eq!(l.finish_line(), Err(()));
+        assert_eq!(s34_state(&l), (m - 1, m, 0, false, false));
+        let mut l = s34_limiter((m - 1, m, 0, false, true));
+        assert_eq!(l.finish_line(), Ok(()));
+        assert_eq!(s34_state(&l), (m - 1, 0, 0, false, true));
+
+        // T03: an ordinary byte on a line of usize::MAX bytes keeps line_size at usize::MAX.
+        let mut l = s34_limiter((m, 0, m, false, false));
+        assert_eq!(l.observe(b"a"), Ok(()));
+        assert_eq!(s34_state(&l), (m, 0, m, false, false));
+    }
+
+    // plan §22 T03/C01/C02 (CR not followed by LF); Theorems.client_side_sse.
+    // SseEventSizeLimiter.observe = `Defs.Sse.observe`; `Sse` checks on "ab\r", "ab\r\r",
+    // "a\rb\n" with bound 9.
+    #[test]
+    fn s34_t03_cr_line_ends() {
+        let mut l = s34_limiter((9, 0, 0, false, false));
+        assert_eq!(l.observe(b"ab\r"), Ok(()));
+        assert_eq!(s34_state(&l), (9, 3, 0, false, true));
+
+        let mut l = s34_limiter((9, 0, 0, false, false));
+        assert_eq!(l.observe(b"ab\r\r"), Ok(()));
+        assert_eq!(s34_state(&l), (9, 0, 0, false, true));
+
+        let mut l = s34_limiter((9, 0, 0, false, false));
+        assert_eq!(l.observe(b"a\rb\n"), Ok(()));
+        assert_eq!(s34_state(&l), (9, 4, 0, false, false));
+    }
+
+    // plan §22 T03/C01/C02 (CRLF split across chunks, state afterwards); Theorems.
+    // client_side_sse.SseEventSizeLimiter.observe and observe_append (C01); `Sse`:
+    // `observeChunks (init 64) ["data: hello\r", "\n"]` = ok, (64, 12, 0, false, false), the
+    // same state as for the unsplit chunk.
+    #[test]
+    fn s34_c01_crlf_split_across_chunks_state() {
+        let mut l = s34_limiter((64, 0, 0, false, false));
+        assert_eq!(l.observe(b"data: hello\r"), Ok(()));
+        assert_eq!(l.observe(b"\n"), Ok(()));
+        assert_eq!(s34_state(&l), (64, 12, 0, false, false));
+
+        let mut whole = s34_limiter((64, 0, 0, false, false));
+        assert_eq!(whole.observe(b"data: hello\r\n"), Ok(()));
+        assert_eq!(s34_state(&whole), (64, 12, 0, false, false));
+    }
+
+    // plan §22 T03/C01/C02 (empty chunk); Theorems.client_side_sse.SseEventSizeLimiter.observe:
+    // `Defs.Sse.observe cap st [] = ⟨true, st⟩` for every state, including one over the bound
+    // left by a failed call.
+    #[test]
+    fn s34_t03_empty_chunk() {
+        for st in [
+            (64, 0, 0, false, false),
+            (9, 3, 0, false, true),
+            (9, 2, 4, true, false),
+            (2, 3, 0, false, false),
+        ] {
+            let mut l = s34_limiter(st);
+            assert_eq!(l.observe(b""), Ok(()), "empty chunk from {st:?}");
+            assert_eq!(s34_state(&l), st, "empty chunk from {st:?}");
+        }
+    }
+
+    // plan §22 T03/C01/C02 (error at a CR byte, state afterwards); Theorems.client_side_sse.
+    // SseEventSizeLimiter.observe; `Sse`: `observe usizeMax64 (init 2) "ab\r"` = ⟨false,
+    // (2, 3, 0, false, false)⟩ (`previous_was_cr` stays false), and an error stops the fold:
+    // `observe usizeMax64 (init 1) "ab\n\n"` = ⟨false, (1, 0, 2, false, false)⟩.
+    #[test]
+    fn s34_t03_error_at_cr_state() {
+        let mut l = s34_limiter((2, 0, 0, false, false));
+        assert_eq!(l.observe(b"ab\r"), Err(()));
+        assert_eq!(s34_state(&l), (2, 3, 0, false, false));
+
+        let mut l = s34_limiter((1, 0, 0, false, false));
+        assert_eq!(l.observe(b"ab\n\n"), Err(()));
+        assert_eq!(s34_state(&l), (1, 0, 2, false, false));
+    }
 }
