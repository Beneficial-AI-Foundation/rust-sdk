+    fn d5_stored_state(
+        expected_issuer: Option<&str>,
+        require_issuer: bool,
+    ) -> StoredAuthorizationState {
+        StoredAuthorizationState::new_with_expected_issuer(
+            &PkceCodeVerifier::new("verifier".to_string()),
+            &CsrfToken::new("csrf".to_string()),
+            expected_issuer.map(str::to_owned),
+            require_issuer,
+        )
