+    // A07 callee is_same_origin: the host compared ignoring ASCII case only (opaque hosts of
+    // a non-special scheme keep their case), the port with its known default.
+    #[test]
+    fn d5_a07_same_origin() {
+        let same = |a: &str, b: &str| {
