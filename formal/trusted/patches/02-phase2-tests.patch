+        assert!(same("foo://Auth.Example/a", "foo://auth.example/b"));
+        assert!(!same("foo://\u{c4}.example/", "foo://\u{e4}.example/"));
+        assert!(!same("https://\u{e9}.example/", "https://e.example/"));
+        assert!(same("https://a.example/", "https://a.example:443/"));
+        assert!(same("http://a.example:80/", "http://a.example/"));
+        assert!(!same("https://a.example/", "https://a.example:8443/"));
+        assert!(!same("http://a.example:443/", "https://a.example/"));
+        assert!(!same("foo://a.example:80/", "foo://a.example/"));
