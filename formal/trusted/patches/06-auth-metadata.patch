+/// The failures of the issuer checks, each the `AuthError` variant of the same name and payload.
+#[allow(clippy::enum_variant_names)]
+enum IssuerError {
+    AuthorizationFailed(String),
+    AuthorizationServerMissingIssuer {
+        expected_issuer: String,
+    },
+    AuthorizationServerMismatch {
+        expected_issuer: String,
+        received_issuer: String,
+    },
+}
+
+impl IssuerError {
+    fn into_auth_error(self) -> AuthError {
+        match self {
+            IssuerError::AuthorizationFailed(message) => AuthError::AuthorizationFailed(message),
+            IssuerError::AuthorizationServerMissingIssuer { expected_issuer } => {
+                AuthError::AuthorizationServerMissingIssuer { expected_issuer }
+            }
+            IssuerError::AuthorizationServerMismatch {
+                expected_issuer,
+                received_issuer,
+            } => AuthError::AuthorizationServerMismatch {
+                expected_issuer,
+                received_issuer,
+            },
+        }
+    }
+}
