+/// Wrappers that the verification translation keeps opaque, each the original expression:
+/// `str` pattern APIs, the `url` rewriting of an issuer and the `tracing` events.
+mod prim {
+    use reqwest::Url;
+    use tracing::{debug, warn};
+
+    pub(super) fn trim(s: &str) -> &str {
+        s.trim()
+    }
+
+    pub(super) fn starts_with(s: &str, prefix: &str) -> bool {
+        s.starts_with(prefix)
+    }
+
+    pub(super) fn strip_suffix<'a>(s: &'a str, suffix: &str) -> Option<&'a str> {
+        s.strip_suffix(suffix)
+    }
+
+    /// `path` after the directory `prefix` and its `/`.
+    pub(super) fn strip_dir_prefix<'a>(path: &'a str, prefix: &str) -> Option<&'a str> {
+        path.strip_prefix(&format!("{prefix}/"))
+    }
+
+    pub(super) fn trim_start_slashes(s: &str) -> &str {
+        s.trim_start_matches('/')
+    }
+
+    /// `discovery_url` without query and fragment, with the path `/{issuer_path}` (none if empty).
+    pub(super) fn issuer_url(discovery_url: &Url, issuer_path: &str) -> String {
+        let mut issuer = discovery_url.clone();
+        issuer.set_query(None);
+        issuer.set_fragment(None);
+        if issuer_path.is_empty() {
+            issuer.set_path("");
+        } else {
+            issuer.set_path(&format!("/{issuer_path}"));
+        }
+        issuer.to_string()
+    }
+
+    pub(super) fn debug_empty_resource_metadata() {
+        debug!(target: "rmcp::transport::auth", "ignoring empty resource_metadata value");
+    }
+
+    pub(super) fn debug_unparsable_resource_metadata(value: &str, error: &url::ParseError) {
+        debug!(
+            target: "rmcp::transport::auth",
+            "failed to parse resource metadata value `{value}` as URL: {error}"
+        );
+    }
+
+    pub(super) fn warn_downgraded_resource_metadata(url: &Url, base_url: &Url) {
+        warn!(
+            target: "rmcp::transport::auth",
+            "rejecting resource metadata URL `{url}`: downgrades `{base_url}` from https"
+        );
+    }
+
+    pub(super) fn warn_disallowed_resource_metadata(url: &Url, base_url: &Url) {
+        warn!(
+            target: "rmcp::transport::auth",
+            "rejecting resource metadata URL `{url}`: not same-origin with `{base_url}` and not an allowed metadata host"
+        );
+    }
+}
