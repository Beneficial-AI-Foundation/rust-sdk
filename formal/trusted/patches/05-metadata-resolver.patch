+/// Wrappers that the verification translation keeps opaque, each the original expression:
+/// `str` pattern APIs, the OS resolver `system_lookup` and the proxy env `proxy_env_values`.
+pub(super) mod prim {
+    pub(in crate::transport::auth) fn trim_end_dots(s: &str) -> &str {
+        s.trim_end_matches('.')
+    }
+
+    pub(in crate::transport::auth) fn ends_with(s: &str, suffix: &str) -> bool {
+        s.ends_with(suffix)
+    }
+
+    pub(in crate::transport::auth) fn contains(s: &str, pat: &str) -> bool {
+        s.contains(pat)
+    }
+
+    /// The operating system resolver.
+    pub(super) fn system_lookup() -> super::Lookup {
+        super::Lookup(std::sync::Arc::new(super::SystemResolver))
+    }
+
+    /// The values of the set proxy variables, in the order of `PROXY_ENV_VARS`.
+    pub(super) fn proxy_env_values() -> Vec<String> {
+        super::PROXY_ENV_VARS
+            .iter()
+            .filter_map(|var| std::env::var(var).ok())
+            .collect()
+    }
 }
 
