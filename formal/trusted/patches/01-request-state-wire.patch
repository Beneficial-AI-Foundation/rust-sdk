+    /// RFC 4231 Section 4 test cases 1-4, 6 and 7 (key, data, full 32-byte HMAC-SHA256).
+    fn s16_rfc4231_full_cases() -> Vec<(Vec<u8>, Vec<u8>, Vec<u8>)> {
+        vec![
+            (
+                vec![0x0b; 20],
+                b"Hi There".to_vec(),
+                hex("b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"),
