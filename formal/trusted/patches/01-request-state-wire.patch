+    #[test]
+    fn base64url_roundtrip() {
+        let all: Vec<u8> = (0..=255).collect();
+        for n in 0..all.len() {
+            let mut out = String::new();
+            prim::b64_encode_into(&all[..n], &mut out);
+            assert!(
+                out.bytes()
