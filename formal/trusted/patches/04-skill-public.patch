+/// Wrappers around the string, Unicode, percent-encoding and SHA-256 operations that the
+/// translation cannot see through (`core::str::pattern::Pattern` and `hybrid_array::ArraySize`
+/// have generic associated types). Opaque in the translation; modelled in Lean.
+mod prim {
+    use std::borrow::Cow;
+
+    use sha2::{Digest, Sha256};
+
+    use super::{CONTROLS, UnicodeNormalization, percent_decode_str, utf8_percent_encode};
+
+    pub fn sha256(bytes: &[u8]) -> [u8; 32] {
+        Sha256::digest(bytes).into()
+    }
+
+    pub fn find_query_or_fragment(s: &str) -> Option<usize> {
+        s.find(['?', '#'])
+    }
+
+    pub fn strip_suffix<'a>(s: &'a str, suffix: &str) -> Option<&'a str> {
+        s.strip_suffix(suffix)
+    }
+
+    pub fn strip_prefix<'a>(s: &'a str, prefix: &str) -> Option<&'a str> {
+        s.strip_prefix(prefix)
+    }
+
+    pub fn last_slash_segment(s: &str) -> &str {
+        s.rsplit('/').next().unwrap_or(s)
+    }
+
+    pub fn split_slash(s: &str) -> Vec<String> {
+        s.split('/').map(str::to_owned).collect()
+    }
+
+    pub fn join_slash(segments: Vec<String>) -> String {
+        segments.join("/")
+    }
+
+    pub fn split_once_percent(s: &str) -> Option<(&str, &str)> {
+        s.split_once('%')
+    }
+
+    pub fn split_percent(s: &str) -> Vec<String> {
+        s.split('%').map(str::to_owned).collect()
+    }
+
+    pub fn percent_encode_controls(value: &str) -> Cow<'_, str> {
+        utf8_percent_encode(value, CONTROLS).into()
+    }
+
+    pub fn percent_decode_utf8(s: &str) -> Option<String> {
+        percent_decode_str(s)
+            .decode_utf8()
+            .ok()
+            .map(Cow::into_owned)
+    }
+
+    pub fn nfkc(s: &str) -> Vec<char> {
+        s.nfkc().collect()
+    }
+}
