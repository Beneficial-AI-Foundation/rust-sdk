+/// Wrappers that the verification translation keeps opaque, each the original expression:
+/// `str` pattern and character APIs, `format!` and the `base64` engine `BASE64_STANDARD`.
+mod prim {
+    use base64::{Engine, prelude::BASE64_STANDARD};
+
+    use super::{BASE64_HEADER_PREFIX, BASE64_HEADER_SUFFIX};
+
+    pub(super) fn has_control_or_non_ascii(value: &str) -> bool {
+        value
+            .chars()
+            .any(|c| (c as u32) < 0x20 || (c as u32) > 0x7E)
+    }
+
+    pub(super) fn starts_with(s: &str, prefix: &str) -> bool {
+        s.starts_with(prefix)
+    }
+
+    pub(super) fn ends_with(s: &str, suffix: &str) -> bool {
+        s.ends_with(suffix)
+    }
+
+    pub(super) fn strip_prefix<'a>(s: &'a str, prefix: &str) -> Option<&'a str> {
+        s.strip_prefix(prefix)
+    }
+
+    pub(super) fn strip_suffix<'a>(s: &'a str, suffix: &str) -> Option<&'a str> {
+        s.strip_suffix(suffix)
+    }
+
+    pub(super) fn wrap_sentinel(encoded: &str) -> String {
+        format!("{BASE64_HEADER_PREFIX}{encoded}{BASE64_HEADER_SUFFIX}")
+    }
+
+    pub(super) fn base64_encode(value: &str) -> String {
+        BASE64_STANDARD.encode(value)
+    }
+
+    pub(super) fn base64_decode(value: &str) -> Option<Vec<u8>> {
+        BASE64_STANDARD.decode(value).ok()
+    }
+}
